    <!-- Task 9: setup wizard -->
    <string name="wizard_title">Setup</string>
    <string name="wizard_step_dev_title">Turn on Developer options</string>
    <string name="wizard_step_dev_body">GhostRoute feeds fake locations through Android’s mock-location system. That system only exists once Developer options are enabled — a one-time toggle. Tap “Open settings”, then switch Developer options on.</string>
    <string name="wizard_step_mock_title">Pick the mock location app</string>
    <string name="wizard_step_mock_body">Inside Developer options, find “Select mock location app” and choose GhostRoute. This grants the one permission Android never offers a dialog for. Tap “Open settings” to go there.</string>
    <string name="wizard_picker_guide_title">Where to tap</string>
    <string name="wizard_picker_guide_body">Open settings → Developer options → “Select mock location app” → GhostRoute. Come back here — the checkmark updates on return.</string>
    <!-- P0: first-page setup guide (bundled HTML, EN + فارسی, opens in-app). -->
    <string name="about_guide_title">GhostRoute — Setup Guide</string>
    <string name="about_guide_open">Step-by-step setup guide (developer mode &amp; basics)</string>
    <string name="wizard_step_notif_title">Allow notifications</string>
    <string name="wizard_step_notif_body">Android requires a visible notification while a simulated location is running. Keeping it allowed also lets you stop the simulation straight from the shade.</string>
    <string name="wizard_step_done_title">All set</string>
    <string name="wizard_step_done_body">Setup is complete. You can drop a pin on the map and press Go to simulate. Revisit Setup any time if a check turns red.</string>
